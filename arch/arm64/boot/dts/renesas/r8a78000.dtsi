		a720_0: cpu@0 {
			compatible = "arm,cortex-a720";
			reg = <0x0 0x0>;
			device_type = "cpu";
			next-level-cache = <&L1_CA720_0>;
			enable-method = "psci";

			L1_CA720_0: controller-0 {
				compatible = "cache";
				cache-unified;
				cache-level = <1>;
				next-level-cache = <&L2_CA720_0>;
			};

			L2_CA720_0: controller-1 {
				compatible = "cache";
				cache-unified;
				cache-level = <2>;
				next-level-cache = <&L3_CA720_0>;
			};
		};

