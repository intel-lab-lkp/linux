		};

		DIE_NODE(atcphy2_auspll_fracn_dll_start_capcode): efuse@a1c,18 {
			reg = <0xa1c 4>;
			bits = <18 2>;
		};

		DIE_NODE(atcphy2_aus_cmn_shm_vreg_trim): efuse@a1c,20 {
			reg = <0xa1c 4>;
			bits = <20 5>;
		};

		DIE_NODE(atcphy2_cio3pll_dco_coarsebin0): efuse@a1c,25 {
