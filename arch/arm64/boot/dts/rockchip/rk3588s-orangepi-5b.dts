/dts-v1/;

#include "rk3588s-orangepi-5.dts"

/ {
	model = "Xunlong Orange Pi 5B";
	compatible = "rockchip,rk3588s-orangepi-5", "rockchip,rk3588";
};

&sdhci {
	status = "okay";
};

&sfc {
	status = "disabled";
};

&wireless_bluetooth {
	status = "okay";
};

&wireless_wlan {
	status = "okay";
};
