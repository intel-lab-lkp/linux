			assigned-clocks = <&cru CLK_REF_PCIE1_INNER_PHY>;
			clocks = <&cru CLK_REF_PCIE1_INNER_PHY>,
				 <&cru PCLK_PCIE2_COMBOPHY1>;
			clock-names = "ref", "apb";
			#phy-cells = <1>;
			resets = <&cru SRST_RESETN_PCIE1_PIPE_PHY>;
			reset-names = "phy";
			rockchip,pipe-grf = <&php_grf>;
			rockchip,pipe-phy-grf = <&pipe_phy1_grf>;

			status = "disabled";
		};

		sram: sram@4010f000 {
			compatible = "mmio-sram";
			reg = <0x0 0x4010f000 0x0 0x100>;
			ranges = <0x0 0x0 0x4010f000 0x100>;
			#address-cells = <1>;
			#size-cells = <1>;

			scmi_shmem: scmi-sram-section@0 {
				compatible = "arm,scmi-shmem";
				reg = <0x0 0x100>;
			};
		};
	};

	thermal-zones {
		big_core_thermal: big-core-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <100>;
			thermal-sensors = <&tsadc 4>;

			trips {
				big-core-crit {
					hysteresis = <2000>;
					temperature = <115000>;
					type = "critical";
				};
			};
		};

		center-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <100>;
			thermal-sensors = <&tsadc 0>;

			trips {
				center-crit {
					hysteresis = <2000>;
					temperature = <115000>;
					type = "critical";
				};
			};
		};

		ddr-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <100>;
			thermal-sensors = <&tsadc 2>;

			trips {
				ddr-crit {
					hysteresis = <2000>;
					temperature = <115000>;
					type = "critical";
				};
			};
		};

		gpu-npu-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <100>;
			thermal-sensors = <&tsadc 1>;

			trips {
				gpu-npu-crit {
					hysteresis = <2000>;
					temperature = <115000>;
					type = "critical";
				};
			};
		};

		little_core_thermal: little-core-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <100>;
			thermal-sensors = <&tsadc 3>;

			trips {
				little-core-crit {
					hysteresis = <2000>;
					temperature = <115000>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) |
			     IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) |
			     IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) |
			     IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) |
			     IRQ_TYPE_LEVEL_LOW)>;
	};

	xin24m: xin24m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "xin24m";
	};
};

#include "rk3572-pinctrl.dtsi"
