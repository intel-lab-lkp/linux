#include <dt-bindings/clock/rockchip,rk3572-cru.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/power/rockchip,rk3572-power-controller.h>
#include <dt-bindings/reset/rockchip,rk3572-cru.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "rockchip,rk3572";
	#address-cells = <2>;
	interrupt-parent = <&gic>;
	#size-cells = <2>;

	aliases {
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		i2c8 = &i2c8;
		i2c9 = &i2c9;
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
		serial5 = &uart5;
		serial6 = &uart6;
		serial7 = &uart7;
		serial8 = &uart8;
		serial9 = &uart9;
		serial10 = &uart10;
		serial11 = &uart11;
	};

	spll: clock-spll {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <702000000>;
		clock-output-names = "spll";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu_l0>;
				};

				core1 {
					cpu = <&cpu_l1>;
				};

				core2 {
					cpu = <&cpu_l2>;
				};

				core3 {
					cpu = <&cpu_l3>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&cpu_l4>;
				};

				core1 {
					cpu = <&cpu_l5>;
				};
			};

			cluster2 {
				core0 {
					cpu = <&cpu_b0>;
				};

				core1 {
					cpu = <&cpu_b1>;
				};
			};
		};

		cpu_l0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0>;
			capacity-dmips-mhz = <669>;
			clocks = <&scmi_clk ARMCLK_L0>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <0x8000>;
			enable-method = "psci";
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <0x8000>;
			next-level-cache = <&l2_cache_l0>;
		};

		cpu_l1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x1>;
			capacity-dmips-mhz = <669>;
			clocks = <&scmi_clk ARMCLK_L0>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <0x8000>;
			enable-method = "psci";
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <0x8000>;
			next-level-cache = <&l2_cache_l0>;
		};

		cpu_l2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x2>;
			capacity-dmips-mhz = <669>;
			clocks = <&scmi_clk ARMCLK_L0>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <0x8000>;
			enable-method = "psci";
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <0x8000>;
			next-level-cache = <&l2_cache_l0>;
		};

		cpu_l3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x3>;
			capacity-dmips-mhz = <669>;
			clocks = <&scmi_clk ARMCLK_L0>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <0x8000>;
			enable-method = "psci";
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <0x8000>;
			next-level-cache = <&l2_cache_l0>;
		};

		cpu_l4: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x100>;
			capacity-dmips-mhz = <563>;
			clocks = <&scmi_clk ARMCLK_L1>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <0x8000>;
			enable-method = "psci";
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <0x8000>;
			next-level-cache = <&l2_cache_l1>;
		};

		cpu_l5: cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x101>;
			capacity-dmips-mhz = <563>;
			clocks = <&scmi_clk ARMCLK_L1>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <0x8000>;
			enable-method = "psci";
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <0x8000>;
			next-level-cache = <&l2_cache_l1>;
		};

		cpu_b0: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x200>;
			capacity-dmips-mhz = <1024>;
			clocks = <&scmi_clk ARMCLK_B>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <0x8000>;
			enable-method = "psci";
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <0x10000>;
			next-level-cache = <&l2_cache_b>;
		};

		cpu_b1: cpu@201 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x201>;
			capacity-dmips-mhz = <1024>;
			clocks = <&scmi_clk ARMCLK_B>;
			d-cache-line-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <0x8000>;
			enable-method = "psci";
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			i-cache-size = <0x10000>;
			next-level-cache = <&l2_cache_b>;
		};

		l2_cache_l0: l2-cache-cluster0 {
			compatible = "cache";
			cache-level = <2>;
			cache-line-size = <64>;
			cache-sets = <512>;
			cache-size = <0x80000>;
			cache-unified;
		};

		l2_cache_l1: l2-cache-cluster1 {
			compatible = "cache";
			cache-level = <2>;
			cache-line-size = <64>;
			cache-sets = <256>;
			cache-size = <0x40000>;
			cache-unified;
		};

		l2_cache_b: l2-cache-cluster2 {
			compatible = "cache";
			cache-level = <2>;
			cache-line-size = <64>;
			cache-sets = <512>;
			cache-size = <0x80000>;
			cache-unified;
		};
	};

	firmware {
		scmi: scmi {
			compatible = "arm,scmi-smc";
			#address-cells = <1>;
			shmem = <&scmi_shmem>;
			#size-cells = <0>;
			arm,smc-id = <0x82000010>;

			scmi_clk: protocol@14 {
				reg = <0x14>;
				#clock-cells = <1>;
			};
		};
	};

	pinctrl: pinctrl {
		compatible = "rockchip,rk3572-pinctrl";
		ranges;
		#address-cells = <2>;
		#size-cells = <2>;
		rockchip,grf = <&ioc_grf>;

		gpio0: gpio@26300000 {
			compatible = "rockchip,rk3572-gpio-bank";
			reg = <0x0 0x26300000 0x0 0x200>;
			clocks = <&cru PCLK_GPIO0>, <&cru DBCLK_GPIO0>;
			#gpio-cells = <2>;
			gpio-controller;
			gpio-ranges = <&pinctrl 0 0 32>;
			#interrupt-cells = <2>;
			interrupt-controller;
			interrupts = <GIC_SPI 104 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 107 IRQ_TYPE_LEVEL_HIGH>;
		};

		gpio1: gpio@2b200000 {
			compatible = "rockchip,rk3572-gpio-bank";
			reg = <0x0 0x2b200000 0x0 0x200>;
			clocks = <&cru PCLK_GPIO1>, <&cru DBCLK_GPIO1>;
			#gpio-cells = <2>;
			gpio-controller;
			gpio-ranges = <&pinctrl 0 32 32>;
			#interrupt-cells = <2>;
			interrupt-controller;
			interrupts = <GIC_SPI 108 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>;
		};

		gpio2: gpio@2b300000 {
			compatible = "rockchip,rk3572-gpio-bank";
			reg = <0x0 0x2b300000 0x0 0x200>;
			clocks = <&cru PCLK_GPIO2>, <&cru DBCLK_GPIO2>;
			#gpio-cells = <2>;
			gpio-controller;
			gpio-ranges = <&pinctrl 0 64 32>;
			#interrupt-cells = <2>;
			interrupt-controller;
			interrupts = <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 113 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 114 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 115 IRQ_TYPE_LEVEL_HIGH>;
		};

		gpio3: gpio@2b400000 {
			compatible = "rockchip,rk3572-gpio-bank";
			reg = <0x0 0x2b400000 0x0 0x200>;
			clocks = <&cru PCLK_GPIO3>, <&cru DBCLK_GPIO3>;
			#gpio-cells = <2>;
			gpio-controller;
			gpio-ranges = <&pinctrl 0 96 32>;
			#interrupt-cells = <2>;
			interrupt-controller;
			interrupts = <GIC_SPI 116 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 117 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 119 IRQ_TYPE_LEVEL_HIGH>;
		};

		gpio4: gpio@2b500000 {
			compatible = "rockchip,rk3572-gpio-bank";
			reg = <0x0 0x2b500000 0x0 0x200>;
			clocks = <&cru PCLK_GPIO4>, <&cru DBCLK_GPIO4>;
			#gpio-cells = <2>;
			gpio-controller;
			gpio-ranges = <&pinctrl 0 128 32>;
			#interrupt-cells = <2>;
			interrupt-controller;
			interrupts = <GIC_SPI 120 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 121 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 122 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 123 IRQ_TYPE_LEVEL_HIGH>;
		};
	};

	psci: psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	soc {
		compatible = "simple-bus";
		ranges;
		#address-cells = <2>;
		#size-cells = <2>;

		usb_drd0_dwc3: usb@24000000 {
			compatible = "rockchip,rk3572-dwc3";
			reg = <0x0 0x24000000 0x0 0x400000>;
			clocks = <&cru CLK_REF_USB3OTG0>,
				 <&cru CLK_SUSPEND_USB3OTG0>,
				 <&cru ACLK_USB3OTG0>;
			clock-names = "ref_clk", "suspend_clk", "bus_clk";
			dma-coherent;
			interrupts = <GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH>;
			phy_type = "utmi_wide";
			phys = <&u2phy0_otg>, <&combphy0_psu PHY_TYPE_USB3>;
			phy-names = "usb2-phy", "usb3-phy";
			power-domains = <&power RK3572_PD_PHP>;
			resets = <&cru SRST_ARESETN_USB3OTG0>;
			rockchip,grf = <&php_grf 0x14>;
			snps,dis-u1-entry-quirk;
			snps,dis-u2-entry-quirk;
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis_enblslpm_quirk;
			snps,parkmode-disable-hs-quirk;
			snps,parkmode-disable-ss-quirk;

			status = "disabled";
		};

		usb_drd1_dwc3: usb@24400000 {
			compatible = "rockchip,rk3572-dwc3";
			reg = <0x0 0x24400000 0x0 0x400000>;
			clocks = <&cru CLK_REF_USB3OTG1>,
				 <&cru CLK_SUSPEND_USB3OTG1>,
				 <&cru ACLK_USB3OTG1>;
			clock-names = "ref_clk", "suspend_clk", "bus_clk";
			dma-coherent;
			interrupts = <GIC_SPI 254 IRQ_TYPE_LEVEL_HIGH>;
			phy_type = "utmi_wide";
			phys = <&u2phy1_otg>, <&combphy1_psu PHY_TYPE_USB3>;
			phy-names = "usb2-phy", "usb3-phy";
			power-domains = <&power RK3572_PD_PHP>;
			resets = <&cru SRST_ARESETN_USB3OTG1>;
			rockchip,grf = <&php_grf 0x34>;
			snps,dis-u1-entry-quirk;
			snps,dis-u2-entry-quirk;
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis_enblslpm_quirk;
			snps,parkmode-disable-hs-quirk;
			snps,parkmode-disable-ss-quirk;

			status = "disabled";
		};

		sys_grf: syscon@26010000 {
			compatible = "rockchip,rk3572-sys-grf", "syscon";
			reg = <0x0 0x26010000 0x0 0x2000>;
		};

		php_grf: syscon@26026000 {
			compatible = "rockchip,rk3572-php-grf", "syscon";
			reg = <0x0 0x26026000 0x0 0x1000>;
			clocks = <&cru PCLK_PHPSUBSYS_ROOT>;
		};

		nvm0_grf: syscon@2602a000 {
			compatible = "rockchip,rk3572-nvm0-grf", "syscon";
			reg = <0x0 0x2602a000 0x0 0x1000>;
			clocks = <&cru PCLK_NVM0_ROOT>;
		};

		pmu0_grf: syscon@26040000 {
			compatible = "rockchip,rk3572-pmu0-grf", "syscon";
			reg = <0x0 0x26040000 0x0 0x1000>;
		};

		pipe_phy0_grf: syscon@2604e000 {
			compatible = "rockchip,rk3572-pipe-phy-grf", "syscon";
			reg = <0x0 0x2604e000 0x0 0x2000>;
			clocks = <&cru PCLK_PHPSUBSYS_ROOT>;
		};

		pipe_phy1_grf: syscon@26050000 {
			compatible = "rockchip,rk3572-pipe-phy-grf", "syscon";
			reg = <0x0 0x26050000 0x0 0x2000>;
			clocks = <&cru PCLK_PHPSUBSYS_ROOT>;
		};

		usb2phy_grf: syscon@26054000 {
			compatible = "rockchip,rk3572-usb2phy-grf",
				     "syscon",
				     "simple-mfd";
			reg = <0x0 0x26054000 0x0 0x4000>;
			#address-cells = <1>;
			clocks = <&cru PCLK_PHPSUBSYS_ROOT>;
			#size-cells = <1>;

			u2phy0: usb2phy@0 {
				compatible = "rockchip,rk3572-usb2phy";
				reg = <0x0 0x10>;
				#clock-cells = <0>;
				clock-output-names = "usb480m_phy0";
				clocks = <&xin24m>, <&cru PCLK_PHPSUBSYS_ROOT>;
				clock-names = "phyclk", "pclk";
				resets = <&cru SRST_RESETN_OTGPHY_0>,
					 <&cru SRST_PRESETN_USBPHY_GRF_0>;
				reset-names = "phy", "apb";

				status = "disabled";

				u2phy0_otg: otg-port {
					interrupts = <GIC_SPI 288
						     IRQ_TYPE_LEVEL_HIGH>,
						     <GIC_SPI 289
						     IRQ_TYPE_LEVEL_HIGH>,
						     <GIC_SPI 290
						     IRQ_TYPE_LEVEL_HIGH>;
					interrupt-names = "otg-bvalid",
							  "otg-id",
							  "linestate";
					#phy-cells = <0>;

					status = "disabled";
				};
			};

			u2phy1: usb2phy@2000 {
				compatible = "rockchip,rk3572-usb2phy";
				reg = <0x2000 0x10>;
				#clock-cells = <0>;
				clock-output-names = "usb480m_phy1";
				clocks = <&xin24m>, <&cru PCLK_PHPSUBSYS_ROOT>;
				clock-names = "phyclk", "pclk";
				resets = <&cru SRST_RESETN_OTGPHY_1>,
					 <&cru SRST_PRESETN_USBPHY_GRF_1>;
				reset-names = "phy", "apb";

				status = "disabled";

				u2phy1_otg: otg-port {
					interrupts = <GIC_SPI 293
						     IRQ_TYPE_LEVEL_HIGH>,
						     <GIC_SPI 294
						     IRQ_TYPE_LEVEL_HIGH>,
						     <GIC_SPI 295
						     IRQ_TYPE_LEVEL_HIGH>;
					interrupt-names = "otg-bvalid",
							  "otg-id",
							  "linestate";
					#phy-cells = <0>;

					status = "disabled";
				};
			};
		};

		ioc_grf: syscon@26072000 {
			compatible = "rockchip,rk3572-ioc-grf", "syscon";
			reg = <0x0 0x26072000 0x0 0x16000>;
		};

		cru: clock-controller@26090000 {
			compatible = "rockchip,rk3572-cru";
			reg = <0x0 0x26090000 0x0 0x60000>;
			assigned-clock-rates = <1000000000>,
					       <18432000>,
					       <96000000>,
					       <128000000>;
			assigned-clocks = <&cru PLL_CPLL>,
					  <&cru CLK_UART_FRAC_0>,
					  <&cru CLK_UART_FRAC_1>,
					  <&cru CLK_UART_FRAC_2>;
			#clock-cells = <1>;
			clocks = <&xin24m>;
			clock-names = "xin24m";
			#reset-cells = <1>;
			rockchip,grf = <&pmu0_grf>;
		};

		uart1: serial@26500000 {
			compatible = "rockchip,rk3572-uart", "snps,dw-apb-uart";
			reg = <0x0 0x26500000 0x0 0x100>;
			clocks = <&cru SCLK_UART1>, <&cru PCLK_UART1>;
			clock-names = "baudclk", "apb_pclk";
			interrupts = <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-0 = <&uart1m0_xfer_pins>;
			pinctrl-names = "default";
			reg-io-width = <4>;
			reg-shift = <2>;

			status = "disabled";
		};

		i2c0: i2c@26520000 {
			compatible = "rockchip,rk3572-i2c",
				     "rockchip,rk3399-i2c";
			reg = <0x0 0x26520000 0x0 0x1000>;
			#address-cells = <1>;
			clocks = <&cru CLK_I2C0>, <&cru PCLK_I2C0>;
			clock-names = "i2c", "pclk";
			interrupts = <GIC_SPI 89 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-0 = <&i2c0m0_xfer_pins>;
			pinctrl-names = "default";
			#size-cells = <0>;

			status = "disabled";
		};

		pmu: power-management@26550000 {
			compatible = "rockchip,rk3572-pmu",
				     "syscon",
				     "simple-mfd";
			reg = <0x0 0x26550000 0x0 0x1000>;

			power: power-controller {
				compatible = "rockchip,rk3572-power-controller";
				#address-cells = <1>;
				#power-domain-cells = <1>;
				#size-cells = <0>;
				rockchip,grf = <&sys_grf>;

				power-domain@3 {
					reg = <RK3572_PD_NVM1>;
					pm_qos = <&qos_fspi1>, <&qos_sdmmc0>;
					#power-domain-cells = <0>;
				};

				power-domain@5 {
					reg = <RK3572_PD_PHP>;
					pm_qos = <&qos_gmac0>,
						 <&qos_pcie0>,
						 <&qos_pcie1>,
						 <&qos_sata0>,
						 <&qos_sata1>,
						 <&qos_ufshc>,
						 <&qos_usb0>,
						 <&qos_usb1>;
					#power-domain-cells = <0>;
				};

				power-domain@c {
					reg = <RK3572_PD_VOP>;
					#address-cells = <1>;
					pm_qos = <&qos_vop_m0>, <&qos_vop_m1ro>;
					#power-domain-cells = <0>;
					#size-cells = <0>;

					power-domain@2 {
						reg = <RK3572_PD_NVM0>;
						pm_qos = <&qos_emmc>,
							 <&qos_fspi0>,
							 <&qos_gmac1>,
							 <&qos_sdmmc1>;
						#power-domain-cells = <0>;
					};
				};
			};
		};

		qos_fspi1: qos@27802000 {
			compatible = "rockchip,rk3572-qos", "syscon";
			reg = <0x0 0x27802000 0x0 0x20>;
		};

		qos_sdmmc0: qos@27802080 {
			compatible = "rockchip,rk3572-qos", "syscon";
			reg = <0x0 0x27802080 0x0 0x20>;
		};

		qos_emmc: qos@27809000 {
			compatible = "rockchip,rk3572-qos", "syscon";
			reg = <0x0 0x27809000 0x0 0x20>;
		};

		qos_fspi0: qos@27809080 {
			compatible = "rockchip,rk3572-qos", "syscon";
			reg = <0x0 0x27809080 0x0 0x20>;
		};

		qos_gmac1: qos@27809100 {
			compatible = "rockchip,rk3572-qos", "syscon";
			reg = <0x0 0x27809100 0x0 0x20>;
		};

		qos_sdmmc1: qos@27809180 {
			compatible = "rockchip,rk3572-qos", "syscon";
			reg = <0x0 0x27809180 0x0 0x20>;
		};

		qos_gmac0: qos@2780a000 {
			compatible = "rockchip,rk3572-qos", "syscon";
