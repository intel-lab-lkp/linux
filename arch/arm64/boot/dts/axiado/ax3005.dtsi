		};

		gpio5: gpio-controller@33280000 {
			compatible = "axiado,ax3005-gpio", "axiado,ax3000-gpio", "cdns,gpio-r1p02";
			reg = <0x0 0x33280000 0x0 0x100>;
			clocks = <&pclk>;
