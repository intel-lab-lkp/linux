			status = "disabled";
		};

		i2c2: i2c@33080400 {
			compatible = "axiado,ax3005-i2c", "cdns,i2c-r1p14";
			reg = <0x0 0x33080400 0x0 0x400>;
			clocks = <&pclk>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 78 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c3: i2c@33080800 {
			compatible = "axiado,ax3005-i2c", "cdns,i2c-r1p14";
