// SPDX-License-Identifier: GPL-2.0
/*
 * Device tree for EBDEE EdgeBoard FZ3A carrier board
 * populated with the MYIR MYS-CZU3EG SoM
 * (Xilinx ZynqMP XCZU3EG, quad Cortex-A53 + PL, 2GB DDR4, 8GB eMMC).
 *
 * Copyright (c) 2026 Pufan Jin
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/pinctrl/pinctrl-zynqmp.h>
#include "zynqmp.dtsi"
#include "zynqmp-clk-ccf.dtsi"

/ {
	model = "EBDEE EdgeBoard FZ3A (MYIR MYS-CZU3EG SoM)";
	compatible = "ebdee,edgeboard-fz3a", "xlnx,zynqmp";

	aliases {
		ethernet0 = &gem3;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		mmc0 = &sdhci0;
		mmc1 = &sdhci1;
		serial0 = &uart1;
		serial1 = &uart0;
		spi0 = &qspi;
		usb0 = &usb0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	dpcon: connector {
		compatible = "dp-connector";
		label = "mini-DP";
		type = "mini";

		port {
			dpcon_in: endpoint {
				remote-endpoint = <&dpsub_dp_out>;
			};
		};
	};

	dp_aclk: clock-dp-aclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	gtr_refclk0: clock-gtr-ref0 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	gtr_refclk1: clock-gtr-ref1 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
	};

	gtr_refclk2: clock-gtr-ref2 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <27000000>;
	};

	/*
	 * The PM firmware on this ZU3EG does not report the LPD_LSBUS
	 * clock id as valid, so <&zynqmp_clk LPD_LSBUS> resolves to no
	 * clock at all and drivers that require their bus clock fail to
	 * probe.
	 */
	lpd_lsbus: clock-lpd-lsbus {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x7ff00000>;
	};

	vcc_3v3_pcie: regulator-pcie {
		compatible = "regulator-fixed";
		regulator-name = "pcie-reset";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&gpio 37 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux_cma: cma {
			compatible = "shared-dma-pool";
			reusable;
			alloc-ranges = <0x0 0x0 0x0 0x80000000>;
			size = <0x0 0x20000000>;	/* 512MB */
			linux,cma-default;
		};
	};
};

&ams_pl {
	status = "okay";
};

&ams_ps {
	status = "okay";
};

&dwc3_0 {
	dr_mode = "host";
	maximum-speed = "super-speed";
	snps,dis_enblslpm_quirk;
	snps,dis_u2_susphy_quirk;
	snps,hsphy_interface = "ulpi";
	snps,usb3_lpm_capable;
	status = "okay";
};

&gem3 {
	clocks = <&lpd_lsbus>, <&zynqmp_clk GEM3_REF>,
		 <&zynqmp_clk GEM3_TX>, <&zynqmp_clk GEM3_RX>,
		 <&zynqmp_clk GEM_TSU>;
	phy-mode = "rgmii-id";
	status = "okay";
};

&gpio {
	status = "okay";
};

&i2c0 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c0_default>;
	status = "okay";
};

&i2c1 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c1_default>;
	status = "okay";
};

&out_dp {
	dpsub_dp_out: endpoint {
		remote-endpoint = <&dpcon_in>;
	};
};

&pcie {
	phys = <&psgtr 0 PHY_TYPE_PCIE 0 0>;

	status = "okay";
};

&pinctrl0 {
	status = "okay";

	pinctrl_i2c0_default: i2c0-default {
		conf {
			bias-pull-up;
			groups = "i2c0_8_grp";
		};

		mux {
			function = "i2c0";
			groups = "i2c0_8_grp";
		};
	};

	pinctrl_i2c1_default: i2c1-default {
		conf {
			bias-pull-up;
			groups = "i2c1_8_grp";
		};

		mux {
			function = "i2c1";
			groups = "i2c1_8_grp";
		};
	};

	pinctrl_usb0_default: usb0-default {
		mux {
			function = "usb0";
			groups = "usb0_0_grp";
		};
	};
};

&psgtr {
	clocks = <&gtr_refclk0>, <&gtr_refclk1>, <&gtr_refclk2>;
	clock-names = "ref0", "ref1", "ref2";

	status = "okay";
};

&qspi {
	num-cs = <1>;
	status = "okay";

	flash: flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0x0>;
		spi-max-frequency = <50000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

&sdhci0 {
	no-1-8-v;
	status = "okay";
};

&sdhci1 {
	disable-wp;
	no-1-8-v;
	status = "okay";
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&usb0 {
	phy-names = "usb3-phy";
	phys = <&psgtr 1 PHY_TYPE_USB3 0 1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usb0_default>;
	reset-gpios = <&gpio 44 GPIO_ACTIVE_LOW>;

	status = "okay";
};

&zynqmp_dpdma {
	status = "okay";
};

&zynqmp_dpsub {
	clocks = <&dp_aclk>,
		 <&zynqmp_clk DP_AUDIO_REF>,
		 <&zynqmp_clk DP_VIDEO_REF>;
	clock-names = "dp_apb_clk", "dp_aud_clk", "dp_vtc_pixel_clk_in";
	phy-names = "dp-phy0", "dp-phy1";
	phys = <&psgtr 3 PHY_TYPE_DP 0 2>,
	       <&psgtr 2 PHY_TYPE_DP 1 2>;
	status = "okay";
};
