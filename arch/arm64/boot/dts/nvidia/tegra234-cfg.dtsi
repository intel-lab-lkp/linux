		i2c@c240000 {
			config-settings = <&configi2c7>;
		};

		i2c@c250000 {
			config-settings = <&configi2c8>;
		};

		mmc@3400000 {
			config-settings = <&configmmc1>;
		};

		mmc@3460000 {
			config-settings = <&configmmc2>;
		};

	};
