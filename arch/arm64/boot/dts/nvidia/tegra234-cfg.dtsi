		configmmc1: config-mmc3400000 {

			sdhci-mmc-hs200-cfg {
				nvidia,num-tuning-iter = <0x2>;
			};

			sdhci-uhs-sdr104-cfg {
				nvidia,num-tuning-iter = <0x2>;
			};

			sdhci-uhs-sdr50-cfg {
				nvidia,num-tuning-iter = <0x4>;
			};

