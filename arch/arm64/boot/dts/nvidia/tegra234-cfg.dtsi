				nvidia,num-tuning-iter = <0x2>;
			};

			sdhci-mmc-hs400-cfg {
				nvidia,num-tuning-iter = <0x2>;
			};

		};

	};

	bus@0 {
		i2c@3160000 {
			config-settings = <&configi2c1>;
		};

		i2c@3180000 {
			config-settings = <&configi2c2>;
		};

		i2c@3190000 {
			config-settings = <&configi2c3>;
		};

		i2c@31b0000 {
