config AS_APX
	def_bool $(as-instr64,xor %r16$(comma)%r16)
	help
	  Supported by binutils >= 2.42 and LLVM integrated assembler >= V18

config AS_WRUSS
	def_bool $(as-instr64,wrussq %rax$(comma)(%rbx))
	help
	  Supported by binutils >= 2.31 and LLVM integrated assembler
