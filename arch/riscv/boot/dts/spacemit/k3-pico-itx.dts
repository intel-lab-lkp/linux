#include "k3.dtsi"

/ {
	model = "SpacemiT K3 Pico-ITX";
	compatible = "spacemit,k3-pico-itx", "spacemit,k3";

	chosen {
		stdout-path = "serial0";
	};

	memory@100200000 {
		device_type = "memory";
		reg = <0x1 0x00200000 0x3 0xffe00000>;
	};
};

&uart0 {
	status = "okay";
};
