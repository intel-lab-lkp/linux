/dts-v1/;
#include "mstar-infinity2m-ssd202d.dtsi"

/ {
	model = "Miyoo Mini";
	compatible = "miyoo,miyoo-mini", "mstar,infinity2m";

	aliases {
		serial0 = &pm_uart;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	vibrator {
		compatible = "gpio-vibrator";
		enable-gpios = <&gpio SSD20XD_GPIO_UART0_TX GPIO_ACTIVE_LOW>;
	};

};

&pm_uart {
	status = "okay";
};
