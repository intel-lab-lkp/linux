#include "am335x-emperor-common.dtsi"
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Kamstrup READy Concentrator 1M/2M/2C";
	compatible = "kam,am335x-emperor", "ti,am33xx";
};

