		"SYS_BOOT15",
		"RADIO_TEMP_CRIT",
		"RADIO_TEMP_ALERT",
		"I2C1_SDA",
		"I2C1_SCL",
		"MII1_TXD3",
		"MII1_TXD2",
		"USB0_DRVVBUS",
		"RADIO_GPIO4",
		"RADIO_IRQ",
		"MII1_TXD1",
		"NC",
