				reg = <0x54>;
			};
		};

		imux21: i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
			gpio@49 {
				compatible = "nxp,pca9537";
				reg = <0x49>;
			};

			eeprom@50 {
				compatible = "atmel,24c128";
				reg = <0x50>;
			};

