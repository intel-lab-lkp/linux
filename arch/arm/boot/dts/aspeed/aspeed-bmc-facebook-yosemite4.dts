		imux22: i2c@2 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <2>;
			gpio@49 {
				compatible = "nxp,pca9537";
				reg = <0x49>;
			};

			eeprom@50 {
				compatible = "atmel,24c128";
				reg = <0x50>;
			};

			eeprom@51 {
				compatible = "atmel,24c128";
				reg = <0x51>;
			};

			eeprom@54 {
				compatible = "atmel,24c128";
				reg = <0x54>;
